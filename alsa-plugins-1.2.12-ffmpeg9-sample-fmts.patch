--- alsa-plugins-1.2.12/a52/pcm_a52.c	2024-06-10 11:18:39.000000000 +0200
+++ alsa-plugins-1.2.12/a52/pcm_a52.c	2026-08-12 23:19:50.859854988 +0200
@@ -1202,7 +1202,17 @@
 	rec->io.flags = SND_PCM_IOPLUG_FLAG_BOUNDARY_WA;
 #endif
 #ifdef USE_AVCODEC_FRAME
-	rec->av_format = rec->codec->sample_fmts[0];
+	/* AVCodec.sample_fmts removed in modern FFmpeg; query supported configs */
+	{
+		const enum AVSampleFormat *sample_fmts = NULL;
+		if (avcodec_get_supported_config(NULL, rec->codec,
+						AV_CODEC_CONFIG_SAMPLE_FORMAT, 0,
+						(const void **)&sample_fmts, NULL) < 0 ||
+		    !sample_fmts || sample_fmts[0] == AV_SAMPLE_FMT_NONE)
+			rec->av_format = AV_SAMPLE_FMT_S16;
+		else
+			rec->av_format = sample_fmts[0];
+	}
 	rec->is_planar = av_sample_fmt_is_planar(rec->av_format);
 #else
 	rec->av_format = AV_SAMPLE_FMT_S16;
